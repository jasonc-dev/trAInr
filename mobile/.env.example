# Mobile App Environment Configuration
# Copy to .env and set when running Expo. Restart Expo after changing.

# API URL - Backend must be running with: dotnet run --launch-profile http-mobile (listens on 0.0.0.0:5001)
# iOS Simulator: http://localhost:5001/api/v1
# Android Emulator: http://10.0.2.2:5001/api/v1
# Physical device / Expo Go: http://YOUR_COMPUTER_IP:5001/api/v1 (e.g. http://192.168.0.92:5001/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:5001/api/v1
